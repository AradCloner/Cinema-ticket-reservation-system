            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Standard error body', () => {",
              "  const error = pm.response.json();",
              "  pm.expect(error).to.include.keys('timestamp', 'status', 'error', 'message', 'path');",
              "  pm.expect(error.status).to.eql(pm.response.code);",
              "  pm.expect(error.message).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Login newly registered user",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{authUsername}}\",\n  \"password\": \"{{authPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Session cookie returned', () => pm.expect(pm.cookies.get('JSESSIONID')).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Current user with session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct user, role and no password', () => {",
              "  const data = pm.response.json().data;",
              "  pm.expect(data.username).to.eql(pm.collectionVariables.get('authUsername'));",
              "  pm.expect(data.email).to.eql(pm.collectionVariables.get('authEmail'));",
              "  pm.expect(data.role).to.eql('USER');",
              "  pm.expect(data).not.to.have.property('password');",
              "  pm.expect(data.userId).to.be.a('number').and.above(0);",
              "});",
              "pm.test('Same registered user ID', () => pm.expect(pm.response.json().data.userId).to.eql(Number(pm.collectionVariables.get('authUserId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Get CSRF token using session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/csrf",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('CSRF fields are present', () => {",
              "  ['headerName', 'parameterName', 'token'].forEach(key => pm.expect(data[key]).to.be.a('string').and.not.empty);",
              "});",
              "pm.collectionVariables.set('csrfHeader', data.headerName);",
              "pm.collectionVariables.set('csrfToken', data.token);"
            ]
          }
        }
      ]
    },
